# Copy to .env, keep it private, and choose your externally reachable URL.
# Compose publishes no host port; configure a proxy or the local-only override.
# The image bundles ffmpeg and ffprobe on PATH; host tools are unnecessary.
TWOPOD_BASE_URL=http://localhost:8080
TWOPOD_FEED_TITLE=My YouTube audio
TWOPOD_FEED_DESCRIPTION=Selected YouTube videos as audio episodes
TWOPOD_FEED_LINK=

# Empty generates a random secret persisted in /data/read-token at first start.
# To set one explicitly, generate it with: openssl rand -hex 32
TWOPOD_READ_TOKEN=

# Defaults: 30 days after publication; 10 GiB total state; 512 MiB free reserve.
TWOPOD_RETENTION=720h
TWOPOD_STORAGE_LIMIT_BYTES=10737418240
TWOPOD_MIN_FREE_BYTES=536870912
TWOPOD_PROCESS_TIMEOUT=2h
TWOPOD_MAX_ATTEMPTS=3
TWOPOD_RETRY_DELAY=1m
TWOPOD_POLL_INTERVAL=1s

# Optional. CLI-only installations leave BOTH Telegram fields empty.
TWOPOD_TELEGRAM_BOT_TOKEN=
TWOPOD_TELEGRAM_OPERATOR_ID=
